# Mobile EAS ignore configuration for Fitzo

# Ignore dependencies
node_modules/

# Ignore native builds
android/
ios/

# Ignore Expo and Metro caching
.expo/
dist/

# Ignore environment files
.env.local

# Never upload the Play service-account key to EAS build servers
google-services-key.json

# Store marketing assets — needed for submission, never for compiling.
store-listing/
store-screenshots/
feature-graphic.png

# Scratch
.icon-backup/
.dtest/
_w13.mjs
