{
  "expo": {
    "name": "Fitzo",
    "slug": "fitzo",
    "owner": "fiskerr",
    "version": "1.3.2",
    "sdkVersion": "54.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": [
      "fitzo",
      "com.googleusercontent.apps.1030039443378-bjdf9b2f5hr6o10gth0jg64gqbn0imir"
    ],
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.fitzoapp.fitzo",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access to scan the gym QR code for check-in",
        "NSMicrophoneUsageDescription": "Fitzo uses your microphone so you can speak to the AI coach and log meals by voice instead of typing",
        "NSHealthShareUsageDescription": "Fitzo reads your health data (steps, heart rate, sleep) to give you a complete fitness picture",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.fitzo.app",
      "versionCode": 12,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "fitzo",
              "path": "/auth"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Fitzo to access your camera for QR check-in and workout story photos"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Lexend-Regular.ttf",
            "./assets/fonts/Lexend-Bold.ttf"
          ]
        }
      ],
      "expo-asset",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Fitzo reads your health data (steps, heart rate, sleep) to give you a complete fitness picture",
          "NSHealthUpdateUsageDescription": "Fitzo saves your workout data to Apple Health"
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1030039443378-bjdf9b2f5hr6o10gth0jg64gqbn0imir"
        }
      ],
      "expo-audio",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30c3c5e6-e055-4640-9daa-ae04f9c32ac8"
      }
    }
  }
}
