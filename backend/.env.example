# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/fitzo
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitzo
DB_USER=postgres
DB_PASSWORD=password
# Remote DB hosts default to certificate-verified TLS; loopback defaults to plaintext.
# DB_SSL_MODE=verify-full
# DB_SSL_CA_FILE=/path/to/provider-ca.pem

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3001
NODE_ENV=development

# Cors Configuration
CORS_ORIGIN=http://localhost:19006

# AI Quota (cost control for Gemini endpoints)
# Per-user limits — requests per minute / day / calendar month
AI_BURST_LIMIT=3
AI_DAILY_LIMIT=10
AI_MONTHLY_LIMIT=150

# Cron endpoints (GitHub Actions scheduled workflows call these)
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Dev-only unauthenticated login (auto-login as first user). 
# MUST stay unset in production; opt in explicitly for local development.
ALLOW_DEV_LOGIN=false

# Direct API provider. The laptop-worker option is archived.
AI_PROVIDER=gemini
AI_QUEUE_LIMIT=30
AI_WORKER_WAIT_MS=45000
# Explicit Gemini API fallback and existing Gemini/Groq transcription router.
# Keep false for subscription-only operation. Requires configured API credentials.
AI_WORKER_API_FALLBACK=false

# Pin the verified low-cost model rather than an automatically changing alias.
# The shared provider enforces per-feature output limits and minimal thinking.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FAST_MODEL=gemini-3.1-flash-lite

# Hard ceiling on a single Gemini call, ms. Without one the SDK waits forever:
# an exhausted Flash quota was observed hanging for 150s instead of returning
# a 429, so the user watched a spinner rather than seeing an error.
GEMINI_TIMEOUT_MS=30000

# ── Transcription ───────────────────────────────────────────────────────────
# Groq Whisper: ~2,000 transcriptions/day free vs Gemini's ~250 shared across
# every AI feature. Moving ASR here stops voice logging competing with the
# coach for the same quota. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_TIMEOUT_MS=30000

# Which provider runs ASR; the other is the automatic fallback.
# Defaults to gemini because Whisper is unverified on Hinglish — compare them
# on real recordings first:
#   node scripts/compare_transcription.js clip.m4a
TRANSCRIPTION_PROVIDER=gemini
