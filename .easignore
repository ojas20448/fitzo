# Root EAS ignore configuration for Fitzo workspace

# Ignore node_modules everywhere
node_modules/
**/node_modules/

# Ignore native build folders
mobile/android/
mobile/ios/
**/android/
**/ios/

# Ignore Expo and Metro caching
mobile/.expo/
**/.expo/
mobile/dist/
**/dist/

# Ignore environment files
.env.local
.env.production.local
.env.development.local

# Never upload the Play service-account key to EAS build servers
google-services-key.json
mobile/google-services-key.json

# Ignore heavy media launch folders recursively
brag-output/
brag-output-new/
brag-output-*/

# Ignore temporary agents & skills directories
.agents/
.claude/
.tdad/
.idea/
.vscode/

# The .git directory is 124 MB and is not needed to build. EAS resolves the
# commit hash client-side before upload, so nothing server-side reads this.
# With a .easignore present EAS uploads the working tree rather than a git
# archive, so .git is swept in unless it is named here.
.git/

# The backend is a separate service — the mobile build never imports from it.
backend/

# Local media scratch (851 MB) — gitignored, but name it here too since
# .easignore governs the working-tree upload independently of .gitignore.
Media/

# Store marketing assets: needed for submission, never for compiling the app.
mobile/store-listing/
mobile/store-screenshots/
mobile/feature-graphic.png

# Docs, CI config, agent tooling and scratch output.
.github/
.gemini/
.superpowers/
.impeccable/
docs/
test_compile/
temp.txt
